# Visual Studio 2015 user specific files
HoleShit/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
HoleShit/*.xcodeproj
HoleShit/*.xcworkspace
HoleShit/*.sln
HoleShit/*.suo
HoleShit/*.opensdf
HoleShit/*.sdf
HoleShit/*.VC.db
HoleShit/*.VC.opendb
HoleShit/.vsconfig

# Precompiled Assets
HoleShit/SourceArt/**/*.png
HoleShit/SourceArt/**/*.tga

# Binary Files
HoleShit/Binaries/*
HoleShit/Plugins/**/Binaries/*

# Builds
HoleShit/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
HoleShit/!Build/*/
HoleShit/Build/*/**
HoleShit/!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
HoleShit/!Build/**/*.ico

# Built data for maps
HoleShit/*_BuiltData.uasset

# Configuration files generated by the Editor
HoleShit/Saved/*

# Compiled source files for the engine to use
HoleShit/Intermediate/*
HoleShit/Plugins/**/Intermediate/*

# Cache files for the editor to use
HoleShit/DerivedDataCache/*
